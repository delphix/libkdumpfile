@rootpgt: PGT
  target_as=MACHPHYSADDR
  root=KPHYSADDR:0x4b61e00
  pte_mask=0x0
  pte_format=aarch64
  fields=16,13,13,6

@userpgt: PGT
  target_as=MACHPHYSADDR
  root=NOADDR
  pte_mask=0x0
  pte_format=aarch64
  fields=16,13,13,6

@direct: LINEAR
  target_as=KPHYSADDR
  off=0x1000000000000

@rdirect: LINEAR
  target_as=KVADDR
  off=0xffff000000000000

@machphys_kphys: LINEAR
  target_as=KPHYSADDR
  off=0x0

@kphys_machphys: LINEAR
  target_as=MACHPHYSADDR
  off=0x0

KV -> HW:
0-ffffffffffff: @userpgt
1000000000000-fffeffffffffffff: NONE
ffff000000000000-ffffffffffffffff: @rootpgt

KV -> PHYS:
0-ffffffffffff: @userpgt
1000000000000-fffeffffffffffff: NONE
ffff000000000000-ffff00000007ffff: @rootpgt
ffff000000080000-ffff0001ffffffff: @direct
ffff000200000000-ffffffffffffffff: @rootpgt

KPHYS -> DIRECT:
0-7ffff: NONE
80000-1ffffffff: @rdirect
200000000-ffffffffffffffff: NONE

MACHPHYS -> KPHYS:
0-fffffffffffff: @machphys_kphys
10000000000000-ffffffffffffffff: NONE

KPHYS -> MACHPHYS:
0-fffffffffffff: @kphys_machphys
10000000000000-ffffffffffffffff: NONE
